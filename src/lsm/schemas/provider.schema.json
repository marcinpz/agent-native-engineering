{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-native-engineering.org/schemas/provider.schema.json",
  "title": "Read-only provider result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "capability", "status", "data", "evidence", "errors", "permissions", "request_digest", "observed_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provider": {"$ref": "#/$defs/identity"},
    "capability": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "partial"]},
    "data": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["model"], "properties": {"model": {"type": "object"}}}]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "errors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "path", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "path": {"type": "string"}, "message": {"type": "string", "minLength": 1}}}},
    "permissions": {"type": "object", "additionalProperties": false, "required": ["source_access", "writes_performed"], "properties": {"source_access": {"const": "read"}, "writes_performed": {"const": false}}},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"properties": {"data": {"type": "object"}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"data": {"type": "null"}, "errors": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "partial"}}}, "then": {"properties": {"errors": {"minItems": 1}}}}
  ],
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}, "version": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}}},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["schema_version", "id", "version", "capabilities"], "properties": {"schema_version": {"const": "1.0"}, "id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}, "version": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}, "capabilities": {"const": [{"name": "discover", "read_only": true}]}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "entity_id", "source_uri", "source_ref", "origin", "verification", "confidence", "collected_at"], "properties": {"id": {"type": "string", "minLength": 1}, "entity_id": {"type": "string", "minLength": 1}, "source_uri": {"type": "string", "minLength": 1}, "source_ref": {"type": ["string", "null"]}, "origin": {"enum": ["declared", "observed", "inferred"]}, "verification": {"const": "unverified"}, "confidence": {"type": "null"}, "collected_at": {"type": "string", "format": "date-time", "pattern": "Z$"}}}
  }
}
