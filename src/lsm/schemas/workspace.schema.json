{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lsm:schema:workspace:1.0",
  "title": "Read-only adoption workspace configuration",
  "type": "object", "additionalProperties": false,
  "required": ["workspace_version", "workspace", "base_dir", "mode", "manifest", "provider", "context"],
  "properties": {
    "workspace_version": {"const": "1.0"},
    "workspace": {"type": "string", "minLength": 1},
    "base_dir": {"type": "string", "minLength": 1},
    "mode": {"enum": ["in-repo", "external"]},
    "manifest": {"type": "object"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "seed_ids", "budget"],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "seed_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "budget": {"type": "integer", "minimum": 1}
      }
    }
  }
}
