{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lsm:schema:model:1.1",
  "title": "Living System Model 1.1",
  "description": "Schema 1.0 plus optional informational governance metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "model": {"$ref": "urn:lsm:schema:model:1.0#/properties/model"},
    "nodes": {"$ref": "urn:lsm:schema:model:1.0#/properties/nodes"},
    "edges": {"$ref": "urn:lsm:schema:model:1.0#/properties/edges"},
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["owners"],
      "properties": {
        "owners": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}},
        "policy_uri": {"type": "string", "minLength": 1}
      }
    }
  }
}
