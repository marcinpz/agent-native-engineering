  "nodes": [
    {
      "id": "requirement.feature",
      "type": "requirement",
      "title": "cancel",
      "version": 1,
      "approval": "pending",
      "description": "Add idempotent cancellation with refunds. API.cancel(owner, order_id, key) returns (status, body). Successful cancellation returns 200 and {id, state, refunded}; refunded is integer cents. Only paid orders can be cancelled; shipped orders return 409. Unknown or foreign orders return 404. Empty or non-string keys return 400. A key is scoped to owner: replay on the same order returns the original success without a second refund; reuse for a different order returns 409, even if that order is unknown. Failed requests must not reserve a key. A different key on an already cancelled order returns 409. Store refunds must be observable in store.refunds as (order_id, cents) tuples and persist across API instances sharing a Store. Client.cancel(order_id, key) returns the success body or raises ValueError(status). Existing get behavior remains unchanged. No external I/O or services.",
      "acceptance_criteria": [
        "Add idempotent cancellation with refunds",
        "API.cancel(owner, order_id, key) returns (status, body)",
        "Successful cancellation returns 200 and {id, state, refunded}; refunded is integer cents",
        "Only paid orders can be cancelled; shipped orders return 409",
        "Unknown or foreign orders return 404",
        "Empty or non-string keys return 400",
        "A key is scoped to owner: replay on the same order returns the original success without a second refund; reuse for a different order returns 409, even if that order is unknown",
        "Failed requests must not reserve a key",
        "A different key on an already cancelled order returns 409",
        "Store refunds must be observable in store.refunds as (order_id, cents) tuples and persist across API instances sharing a Store",
        "Client.cancel(order_id, key) returns the success body or raises ValueError(status)",
        "Existing get behavior remains unchanged",
        "No external I/O or services."
      ],
      "provenance": {
        "origin": "declared",
        "source": "README.md#requirements",
        "verification": "unverified"
      }
    },
